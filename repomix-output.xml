WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY .env .env

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.21.1

RUN CGO_ENABLED=0 GOOS=linux go build -o todo-api ./cmd/api/main.go

FROM alpine:3.20

